{
  "name": "solar-gestao-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrations.ts aplicar",
    "db:rollback": "node --env-file-if-exists=.env scripts/migrations.ts desfazer",
    "db:nova-migration": "node --env-file-if-exists=.env scripts/migrations.ts nova",
    "criar-admin": "node --env-file-if-exists=.env scripts/criar-admin.ts",
    "carregar-municipios": "node --env-file-if-exists=.env scripts/carregar-municipios.ts",
    "carregar-atlas": "node --env-file-if-exists=.env scripts/carregar-atlas.ts",
    "importar": "node --env-file-if-exists=.env scripts/importar.ts",
    "dados-demo": "node --env-file-if-exists=.env scripts/dados-demo.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
